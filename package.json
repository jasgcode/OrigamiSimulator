{
  "name": "origamisimulator",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "puppeteer": "^24.40.0"
  },
  "scripts": {
    "dev": "bun server.js",
    "dataset": "python3 tools/generate-uniform-1000.py",
